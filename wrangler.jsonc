
{
  "name": "jhericonllc",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "keep_vars": true,
  "vars": {
    "FORM_FROM_EMAIL": "notifications@notify.jhericon.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
